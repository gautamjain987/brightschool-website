---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Bright School" description="This page does not exist." noindex>
  <section class="wrap section" style="padding-bottom: var(--section)">
    <p class="tag">404</p>
    <h1 style="margin-top: 16px">That page isn't here</h1>
    <p class="lead" style="margin-top: 16px">The link may be old, or the page may have moved when we rebuilt the site.</p>
    <p style="margin-top: 28px; display: flex; flex-wrap: wrap; gap: 16px 20px; align-items: center">
      <a href="/" class="btn btn-primary">Go to the home page</a>
      <a href="/book-now">Book a free trial class</a>
    </p>
  </section>
</Base>

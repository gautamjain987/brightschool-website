---
import { site } from '../data/site';
interface Props { heading?: string; text?: string }
const { heading = 'Try one class, free', text = 'Pick a time that suits you, any day from 10am to 7pm UAE time. Your child builds something in the first hour.' } = Astro.props;
---
<section class="wrap section" style="padding-bottom: var(--section)">
  <div class="trial">
    <div>
      <h2>{heading}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="actions">
      <a href="/book-now" class="btn btn-yellow">Pick a trial time</a>
      <a href={site.whatsapp} class="btn btn-white">Ask on WhatsApp</a>
    </div>
  </div>
</section>
<style>
  .trial { background: var(--purple); color: #fff; border: var(--line); border-radius: var(--r-lg); box-shadow: 8px 8px 0 var(--ink); padding: clamp(28px, 5vw, 52px); display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; }
  .trial > div:first-child { flex: 1 1 420px; min-width: 0; }
  .trial .lead { margin-top: 12px; }
  .actions { display: flex; flex-wrap: wrap; gap: 16px 20px; align-items: center; }
  @media (max-width: 480px) { .actions .btn { width: 100%; text-align: center; } }
</style>

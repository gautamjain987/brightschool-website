---
import { site } from '../data/site';
---
<footer class="wrap foot small">
  <div><strong>{site.name}</strong><br />{site.tagline}</div>
  <div>WhatsApp and phone: <a href={site.whatsapp}>{site.phone}</a><br />Classes: every day, 10am to 7pm UAE time</div>
  <div><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/blog">Blog</a></div>
</footer>
<style>
  .foot { display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; padding-block: 8px 48px; }
  strong { color: var(--ink); }
</style>

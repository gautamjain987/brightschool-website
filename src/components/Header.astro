---
import { site } from '../data/site';
const links = [
  { href: '/curriculum', label: 'Courses' },
  { href: '/ai', label: 'AI classes' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
  { href: '/faq', label: 'FAQ' },
];
---
<header class="wrap head">
  <a href="/" class="logo" aria-label={`${site.name} home`}>
    <span class="sun" aria-hidden="true"></span>{site.name}
  </a>
  <nav aria-label="Main" class="nav-wide">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <a href="/book-now" class="btn btn-yellow btn-sm">Book a free trial</a>
  <details class="nav-narrow">
    <summary>Menu</summary>
    <nav aria-label="Main, mobile">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </details>
</header>
<style>
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 16px; padding-block: 18px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; color: var(--ink); }
  .sun { width: 36px; height: 36px; background: var(--yellow); border: var(--line); border-radius: 50%; }
  nav a { text-decoration: none; padding: 10px 4px; display: inline-block; }
  .nav-wide { display: flex; gap: 24px; }
  .nav-narrow { display: none; }
  @media (max-width: 860px) {
    .nav-wide { display: none; }
    .nav-narrow { display: block; flex-basis: 100%; }
    .nav-narrow summary { font-weight: 700; padding: 10px 0; cursor: pointer; min-height: 44px; }
    .nav-narrow nav { display: flex; flex-direction: column; border-top: var(--line); }
    .nav-narrow nav a { padding: 12px 0; border-bottom: 1px solid var(--lilac); }
  }
  @media (max-width: 420px) { .logo { font-size: 1.35rem; } .sun { width: 30px; height: 30px; } }
</style>
